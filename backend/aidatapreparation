# ============================================================
# 7. PREPARE DATASET
# ============================================================

def prepare_dataset():

    prepared_movies = []

    print()
    print("Reading dataset...")

    with open(
        INPUT_FILE,
        "r",
        encoding="utf-8-sig",
        newline=""
    ) as file:

        reader = csv.DictReader(file)

        print()
        print("Columns found in CSV:")

        if reader.fieldnames:
            for column in reader.fieldnames:
                print("   ", column)

        print()
        print("Preparing movies...")

        for movie in reader:

            prepared_movie = prepare_movie(movie)

            # Only keep records that have a title
            if prepared_movie["title"]:

                prepared_movies.append(prepared_movie)

    return prepared_movies


# ============================================================
# 8. SAVE PREPARED DATASET
# ============================================================

def save_dataset(movies):

    fieldnames = [
        "title",
        "genres",
        "director",
        "cast",
        "description",
        "language",
        "combined_features"
    ]

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8",
        newline=""
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=fieldnames
        )

        writer.writeheader()

        writer.writerows(movies)


