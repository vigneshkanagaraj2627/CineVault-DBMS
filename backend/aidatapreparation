CURRENT_FILE = Path(__file__).resolve()
PROJECT_ROOT = CURRENT_FILE.parents[1]
DATASET_DIR = PROJECT_ROOT / "dataset"

INPUT_FILE = DATASET_DIR / "movies_cleaned.csv"
OUTPUT_FILE = DATASET_DIR / "movies_ai_prepared.csv"


# ============================================================
# 2. CLEAN TEXT
# ============================================================

def clean_text(value):
    """
    Convert a value into clean lowercase text.
    """

    if value is None:
        return ""

    value = str(value).strip().lower()

    # Remove extra spaces
    value = " ".join(value.split())

    return value


# ============================================================
# 3. CLEAN LIST-LIKE DATA
# ============================================================

def clean_list(value):
    """
    Handles values such as:

    ['Action', 'Drama']
    Action, Drama
    Action|Drama

    and converts them into simple text.
    """

    if value is None:
        return ""

    value = str(value).strip()

    if not value:
        return ""

    # Try Python-list format
    try:
        parsed = ast.literal_eval(value)

        if isinstance(parsed, list):
            items = []

            for item in parsed:
                item = clean_text(item)

                if item:
                    items.append(item)

            return " ".join(items)

    except (ValueError, SyntaxError):
        pass

    # Handle pipe-separated values
    if "|" in value:
        parts = value.split("|")

    # Handle comma-separated values
    elif "," in value:
        parts = value.split(",")

    else:
        parts = [value]

    parts = [
        clean_text(part)
        for part in parts
        if clean_text(part)
    ]

    return " ".join(parts)


# ============================================================
# 4. GET COLUMN VALUE SAFELY
# ============================================================

def get_value(movie, possible_names):
    """
    Find a column even if its capitalization is different.
    """

    movie_keys = {
        str(key).strip().lower(): key
        for key in movie.keys()
    }

    for name in possible_names:

        key = movie_keys.get(name.lower())

        if key is not None:
            return movie.get(key, "")

    return ""


# ============================================================
# 5. PREPARE ONE MOVIE
# ============================================================

def prepare_movie(movie):

    title = clean_text(
        get_value(movie, ["title", "movie_title", "name"])
    )

    genres = clean_list(
        get_value(movie, ["genres", "genre"])
    )

    director = clean_text(
        get_value(movie, ["director", "directors"])
    )

    cast = clean_list(
        get_value(movie, ["cast", "actors", "stars"])
    )

    description = clean_text(
        get_value(
            movie,
            [
                "description",
                "plot",
                "overview",
                "summary"
            ]
        )
    )

    language = clean_text(
        get_value(
            movie,
            [
                "language",
                "languages"
            ]
        )
    )

    # --------------------------------------------------------
    # Combine important movie information
    # --------------------------------------------------------

    combined_features = " ".join(
        part
        for part in [
            genres,
            director,
            cast,
            description,
            language
        ]
        if part
    )

    return {
        "title": title,
        "genres": genres,
        "director": director,
        "cast": cast,
        "description": description,
        "language": language,
        "combined_features": combined_features
    }


