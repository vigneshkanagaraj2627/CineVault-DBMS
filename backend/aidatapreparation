        print("-" * 60)

        sample = movies[0]

        for key, value in sample.items():

            print(f"{key}: {value[:200]}")

    print()
    print("=" * 60)
    print("✅ READY FOR MEMBER 2 - AI RECOMMENDATION MODEL")
    print("=" * 60)
    print()


# ============================================================
# 10. MAIN
# ============================================================

def main():

    if not check_dataset():
        return

    try:

        movies = prepare_dataset()

        if not movies:

            print()
            print("❌ No movies were prepared.")
            print("Check the column names in your CSV.")
            return

        save_dataset(movies)

        print_summary(movies)

    except Exception as error:

        print()
        print("=" * 60)
        print("❌ ERROR")
        print("=" * 60)

        print()
        print(error)

        print()
        print("If you see an error above, send me the")
        print("ENTIRE error message.")
        print()


if __name__ == "__main__":
    main()